{
  "name": "marketmind",
  "version": "0.4.0",
  "description": "Lokales Reseller-Tool für Marktpreisrecherche, Flipping-Kalkulation und KI-gestützte Anzeigen auf eBay.de und Kleinanzeigen.de",
  "author": "Marc Lettau-Poelchen <lettau.poelchen@emelpe.de>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/emelpe78/marketmind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emelpe78/marketmind.git",
    "directory": "marketmind"
  },
  "bugs": {
    "url": "https://github.com/emelpe78/marketmind/issues"
  },
  "keywords": [
    "nuxt",
    "vue",
    "ebay",
    "kleinanzeigen",
    "reseller",
    "flipping",
    "price-research",
    "openrouter",
    "sqlite",
    "scraping",
    "marketplace",
    "german"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "TMPDIR=/tmp nuxt dev",
    "generate": "nuxt generate",
    "preview": "PORT=5666 nuxt preview",
    "start": "node .output/server/index.mjs",
    "start:docker": "PORT=5667 HOST=0.0.0.0 MM_PORT=5667 node .output/server/index.mjs",
    "docker:build": "docker compose -f ../docker-compose.yml build",
    "docker:up": "docker compose -f ../docker-compose.yml up -d",
    "docker:down": "docker compose -f ../docker-compose.yml down",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@iconify-json/ph": "^1.2.2",
    "@nuxt/ui": "^4.8.2",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "nuxt": "^4.4.7",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.1",
    "vitest": "^4.1.8"
  }
}
