# -----------------------------------------------------
# MarketMind Config
# -----------------------------------------------------

# SQLite-Datenbank (Pfad nur über .env, nicht über die UI)
# Dev: relativ zum Arbeitsverzeichnis marketmind/ oder absolut (z. B. Nextcloud)
MM_DATABASE_DEV=data/marketmind.db
# Docker: Container-Pfad (/app/data/…) oder Host-Pfad (z. B. Nextcloud) — fehlende Datei wird beim Start angelegt
# Bei Host-Pfad: MARKETMIND_DATA_DIR in Repo-Root .env auf das Elternverzeichnis setzen
MM_DATABASE_DOCKER=/app/data/marketmind.db

# Docker: Hostname für lokale KI (Standard host.docker.internal; localhost in Einstellungen wird automatisch umgeschrieben)
# MM_LOCAL_AI_HOST=host.docker.internal